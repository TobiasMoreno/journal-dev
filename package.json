    "@angular/platform-server": "^21.2.15",
    "@angular/router": "^21.2.15",
    "@angular/ssr": "^21.2.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.2.15",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
